# ─────────────────────────────────────────────────────────────────
# Hospedagem local:  copie este arquivo para .env e ajuste as senhas
# Servidor remoto:   adicione PUBLIC_URL com o endereço público do servidor
#                    (ex: https://meusite.com.br ou http://SEU_IP:3000)
#                    Isso garante que QR codes e callbacks funcionem fora
#                    da máquina local.
# ─────────────────────────────────────────────────────────────────

# URL pública do servidor (deixe vazio para uso local)
PUBLIC_URL=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=disparador
DB_USER=disparador
DB_PASSWORD=sua_senha

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Disparo
DELAY_MIN_SEGUNDOS=20
DELAY_MAX_SEGUNDOS=50

# Probabilidade de micro-pausa de "café" entre mensagens (0 = desativado)
# Padrão: 0.10 (10%). Aumenta para 0.15 em contas novas por segurança.
COFFEE_BREAK_CHANCE=0.10

# ─────────────────────────────────────────────────────────────────
# Chave de criptografia dos tokens da WhatsApp Business Cloud API.
# OBRIGATÓRIA — sem ela o servidor não sobe (falha rápido no boot).
# Gerar uma vez com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA reutilize a mesma chave entre ambientes diferentes (dev/prod),
# e nunca commite este valor real no git.
# ─────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=

# Verify token do webhook da Meta (WhatsApp Business Cloud API)
# Usado para validar a assinatura do endpoint GET /api/oficial/webhook
META_WEBHOOK_VERIFY_TOKEN=

# Servidor
PORT=3000
NODE_ENV=production
