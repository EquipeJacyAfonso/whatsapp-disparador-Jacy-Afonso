# ─────────────────────────────────────────────────────────────────
# Hospedagem local:  copie este arquivo para .env e ajuste as senhas
# Servidor remoto:   adicione PUBLIC_URL com o endereço público do servidor
#                    (ex: https://meusite.com.br ou http://SEU_IP:3000)
#                    Isso garante que QR codes e callbacks funcionem fora
#                    da máquina local.
# ─────────────────────────────────────────────────────────────────

# URL pública do servidor (deixe vazio para uso local)
PUBLIC_URL=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=disparador
DB_USER=disparador
DB_PASSWORD=sua_senha

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Disparo
DELAY_MIN_SEGUNDOS=20
DELAY_MAX_SEGUNDOS=50

# Servidor
PORT=3000
NODE_ENV=production
